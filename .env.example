# Eldorado: Dashboard > Seller API > generate a credential.
# The secret is shown once. Anyone holding it can manage your offers and orders.
ELDORADO_CLIENT_ID=
ELDORADO_CLIENT_SECRET=
ELDORADO_BASE_URL=https://www.eldorado.gg

# Discord: https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=
# Right-click your server / yourself / a channel > Copy ID (needs Developer Mode on).
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
DISCORD_NOTIFY_CHANNEL_ID=
